---
import { Button, Spoiler } from 'astro-pure/user'
// import { Collapse, Timeline } from 'astro-pure/user'
import T from '@/components/T.astro'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import ToolSection from '@/components/about/ToolSection.astro'
import orcaIcon from '@/assets/tools/orca.png'

const headings = [
  { depth: 2, slug: 'hobbies', text: 'Hobbies' },
  { depth: 2, slug: 'tools', text: 'Tools' },
  { depth: 2, slug: 'social-networks', text: 'Social Networks' }
  // { depth: 2, slug: 'gossips', text: 'Gossips' },
  // { depth: 2, slug: 'about-blog', text: 'About Blog' }
]
---

<PageLayout title='About' i18nTitle='nav.about' {headings} comment>
  <p>Developer</p>
  <p>
    I chose to be an engineer to motivate myself to be a lifelong learner. AI has replaced coding, but long live engineering. If one day I don't even need to design software, maybe I will learn to play one guitar on street. But now we are in the best era ever to build the best software. Let's do it hands-on.
  </p>
  <p>
    Motto: Stay hungry, stay foolish. <Spoiler>And eat well, sleep well.</Spoiler>
  </p>
  <Button class='w-fit' href='/projects#sponsorship' variant='ahead'>
    <T k='about.sponsorMe' />
  </Button>

  {/* general-talk */}
  <h2 id='hobbies'>Hobbies</h2>
  <ul>
    <li>fan of the Coach Pop and the Ginóbili-Duncan-Parker trio</li>
    <li>
      R&B/City-Pop/Fingerstyle
    </li>
    <li>RTS games player since 2005</li>
    <li>addicted to learn new things</li>
  </ul>

  {/* tools */}
  <h2 id='tools'>Tools</h2>
  <p>Current support tools as follow:</p>
  <ToolSection
    class='mb-5'
    title='Design'
    tools={[
      {
        name: 'Photoshop',
        description: 'Picture Editing',
        href: 'https://www.adobe.com/products/photoshop',
        icon: import('@/assets/tools/photoshop.svg?raw')
      },
      {
        name: 'ECMAScript',
        description: 'Language',
        href: 'https://tc39.es/',
        icon: import('@/assets/tools/ecmascript.svg?raw')
      },
      {
        name: 'Figma',
        description: 'UI Design',
        href: 'https://www.figma.com/',
        icon: import('@/assets/tools/figma.svg?raw')
      },
      {
        name: 'Canva',
        description: 'Graphic Design',
        href: 'https://www.canva.com/',
        icon: import('@/assets/tools/canva.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Productivity'
    tools={[
      {
        name: 'Chrome',
        description: 'Browser',
        href: 'https://www.google.com/chrome/',
        icon: import('@/assets/tools/chrome.svg?raw')
      },
      {
        name: 'Typeless',
        description: 'Voice Dictation',
        href: 'https://www.typeless.com/',
        icon: import('@/assets/tools/typeless.svg?raw')
      },
      {
        name: 'SiYuan',
        description: 'Note',
        href: 'https://b3log.org/siyuan/',
        icon: import('@/assets/tools/siyuan.svg?raw')
      },
      {
        name: 'Typora',
        description: 'Markdown Editor',
        href: 'https://typora.io/',
        icon: import('@/assets/tools/typora.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Development'
    tools={[
      {
        name: 'Cursor',
        description: 'IDE',
        href: 'https://cursor.com/',
        icon: import('@/assets/tools/cursor.svg?raw')
      },
      {
        name: 'Pi',
        description: 'Coding Agent',
        href: 'https://pi.dev/',
        icon: import('@/assets/tools/pi.svg?raw')
      },
      {
        name: 'Orca',
        description: 'ADE',
        href: 'https://orca.dev/',
        icon: orcaIcon
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Environment'
    tools={[
      {
        name: 'Android',
        description: 'Mobile OS',
        href: 'https://www.android.com/',
        icon: import('@/assets/tools/android.svg?raw')
      },
      {
        name: 'Ubuntu 24.04 LTS',
        description: 'Linux Distribution',
        href: 'https://ubuntu.com/',
        icon: import('@/assets/tools/ubuntu.svg?raw')
      },
      {
        name: 'MacOS Tahoe',
        description: 'MacBook Pro',
        href: 'https://www.apple.com/macos/',
        icon: import('@/assets/tools/apple.svg?raw')
      },
      {
        name: 'Windows 11',
        description: 'Framework Laptop 16',
        href: 'https://news.microsoft.com/windows11-general-availability/',
        icon: import('@/assets/tools/windows11.svg?raw')
      }
    ]}
  />

  {/* social-networks */}
  <h2 id='social-networks'>Social Networks</h2>
  <p>
    
  </p>
  <Substats
    stats={[
      {
        platform: 'GitHub',
        icon: 'github',
        link: 'https://github.com/GZhaoQing',
        text: 'stars',
        api: 'github/GZhaoQing'
      },
      {
        platform: 'Steam',
        icon: 'steam',
        color: '#50769d',
        link: 'https://steamcommunity.com/id/ufocm/',
        text: 'games',
        api: 'steamgames/76561198157638562'
      }
    ]}
  />

  {/* gossips（暂不使用，隐藏）
  <h2 id='gossips'>Gossips</h2>
  <Collapse title='Lorem ipsum'>
    Lorem ipsum dolor sit amet, vidit suscipit at mei. Quem denique mea id. Usu ei regione indoctum
    dissentiunt, cu meliore fuisset mei, vel quod voluptua ne. Ex dicat impedit mel, at eum oratio
    possit voluptatum.
  </Collapse>
  */}

