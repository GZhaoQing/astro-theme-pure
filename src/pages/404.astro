---
import { Button } from 'astro-pure/user'
import T from '@/components/T.astro'
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
  description: 'Not found',
  title: '404',
  i18nTitle: 'page.notFound' as const
}
---

<PageLayout {meta}>
  <div class='px-4 py-10 text-center sm:px-6 lg:px-8'>
    <h1 class='block text-7xl font-bold sm:text-9xl'>404</h1>
    <p class='mt-3 text-muted-foreground'>
      <T k='page.notFoundHint' />
    </p>
    <p class='text-lg'>
      <T k='page.notFoundSorry' />
    </p>
    <Button href='/' variant='ahead' class='mt-5'>
      <T k='common.backHome' />
    </Button>
  </div>
</PageLayout>
