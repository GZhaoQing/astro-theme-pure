---
import { Button, Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import T from '@/components/T.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import { integ } from '@/site-config'

import DocsContents from './DocsContents.astro'

const meta = {
  title: 'Docs',
  description: 'Docs content documentation',
  i18nTitle: 'page.docs' as const
}
---

<PageLayout {meta}>
  <Button href='/' variant='back'>
    <T k='common.back' />
  </Button>
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>
        <T k='page.docsTitle' />
      </h1>
    </div>

    <div id='content' class={cn('animate mt-8 max-w-none md:min-w-[45ch]', integ.typography.class)}>
      <h2 class='text-xl font-medium'>
        <T k='page.docsTheme' />
      </h2>
      <DocsContents title={false} />

      <h2 class='text-xl font-medium'>
        <T k='page.docsFeedback' />
      </h2>
      <p>
        <T k='page.docsFeedbackBody' />
        {' '}
        <a href='https://github.com/cworld1/astro-theme-pure/issues' target='_blank'>Github Issues</a>
      </p>
      <h2 class='text-xl font-medium'>
        <T k='page.docsNews' />
      </h2>
      <p>
        <a href='/docs/rss.xml' target='_blank'><Icon name='rss' /> </a>
      </p>
    </div>
  </main>
</PageLayout>
